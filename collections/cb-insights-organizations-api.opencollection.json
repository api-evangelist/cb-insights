{
  "opencollection": "1.0.0",
  "info": {
    "name": "CB Insights Organizations API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List basic organization information.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cbinsights.com/v2/organizations",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of organizations with basic information about those organizations, based on the parameters defined in the request body. This endpoint never charges credits. You can use this endpoint to match CBI organizations with your own data prior to spending credits on them."
        }
      ]
    }
  ],
  "bundled": true
}