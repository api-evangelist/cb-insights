        {
          "info": {
            "name": "Retrieves historical commercial maturity scores.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cbinsights.com/v2/organizations/:orgId/commercialmaturityhistory",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "CB Insights organization ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get commercial maturity history for the org with orgId"
        },
