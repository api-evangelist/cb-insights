{
  "opencollection": "1.0.0",
  "info": {
    "name": "CB Insights Business Relationships API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "BusinessRelationships",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve business relationships for multiple organizations.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cbinsights.com/v2/businessrelationships",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieved data includes partnerships, client/vendor relationships, and licensing activity, plus AI-generated insights to predict future M&As and shifts in strategy for each organization."
        },
        {
          "info": {
            "name": "Retrieve business relationships for an organization.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cbinsights.com/v2/organizations/:orgId/businessrelationships",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "CB Insights organization ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieved data includes partnerships, client/vendor relationships, and licensing activity, plus AI-generated insights to predict future M&As and shifts in strategy."
        }
      ]
    }
  ],
  "bundled": true
}